# ─────────────────────────────────────────────────────────────
# Frontend configuration
#
# These are build-time values: Vite inlines them into the bundle, so they must
# be present when `pnpm build` runs, not just at container start.
# ─────────────────────────────────────────────────────────────

# Base URL for REST calls.
#   Leave unset (or set to /api) when a reverse proxy serves the API on the same
#   domain as the SPA — recommended, and what the Docker image does.
#   Set to an absolute URL only for a split deployment (frontend and backend on
#   different domains); then also set ALLOWED_ORIGINS on the backend.
# VITE_API_BASE_URL=/api

# Optional override for the WebSocket origin.
#   Only needed if the API is absolute AND its WebSocket host differs from it.
#   WebSocket routes live at /ws, not under the API prefix.
# VITE_WS_ORIGIN=wss://api.example.com

# ── Development only (used by vite.config.ts, never in the bundle) ──
# Where the dev server proxies /api and /ws.
# DEV_API_TARGET=http://127.0.0.1:8000
# DEV_PORT=3000
# DEV_HOST=127.0.0.1
